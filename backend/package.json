{
  "name": "seannylog-reminders",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test",
    "test:runtime": "npm run check && node test/runtime.mjs",
    "check": "wrangler deploy --dry-run --outdir .wrangler/build",
    "db:local": "wrangler d1 migrations apply reminders --local",
    "keys": "node scripts/generate-vapid.mjs"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "wrangler": "4.131.2"
  }
}
